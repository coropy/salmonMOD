    // ========================================================================
    // fullFace U/V 矩形
    // ========================================================================

    @Test
    @DisplayName("全fullFaceが0..16の完全矩形")
    void fullFaceRectangle() {
        for (Direction face : Direction.values()) {
            InkSurfacePatchId pid = InkSurfacePatchId.fullFace(face);
            assertTrue(pid.coversFullUnitSquare(),
                    face + " should cover full unit square");
            assertEquals(0, pid.minU());
            assertEquals(0, pid.minV());
            assertEquals(16, pid.maxU());
            assertEquals(16, pid.maxV());
        }
    }

    // ========================================================================
    // isCanonicalFullCubeFace テスト
    // ========================================================================

    @Test
    @DisplayName("fullFaceが全てisCanonicalFullCubeFace")
    void fullFaceIsCanonical() {
        for (Direction face : Direction.values()) {
            InkSurfacePatchId pid = InkSurfacePatchId.fullFace(face);
            assertTrue(pid.isCanonicalFullCubeFace(),
                    face + " should be canonical full cube face");
        }
    }

    @Test
    @DisplayName("内部planeの全面16×16パッチはisCanonicalFullCubeFace=false")
    void internalFullRectNotCanonical() {
        InkSurfacePatchId pid = new InkSurfacePatchId(Direction.UP, 8, 0, 0, 16, 16);
        assertTrue(pid.coversFullUnitSquare());
        assertFalse(pid.isOuterBoundaryFace());
        assertFalse(pid.isCanonicalFullCubeFace());
    }

    @Test
    @DisplayName("部分パッチ(12×8)はisCanonicalFullCubeFace=false")
    void partialPatchNotCanonical() {
        InkSurfacePatchId pid = new InkSurfacePatchId(Direction.UP, 16, 0, 0, 12, 8);
        assertFalse(pid.coversFullUnitSquare());
        assertTrue(pid.isOuterBoundaryFace());
        assertFalse(pid.isCanonicalFullCubeFace());
    }

    // ========================================================================
    // boundaryPlane の方向完全性
    // ========================================================================

    @Test
    @DisplayName("全軸のPOSITIVE面でplane=index+1, NEGATIVE面でplane=index")
    void boundaryPlaneDirectionConsistency() {
        // UP (POSITIVE Y): plane = y + 1
        assertEquals(9, InkSurfacePatchExtractor.boundaryPlane(Direction.UP, 0, 8, 0));

        // DOWN (NEGATIVE Y): plane = y
        assertEquals(8, InkSurfacePatchExtractor.boundaryPlane(Direction.DOWN, 0, 8, 0));

        // EAST (POSITIVE X): plane = x + 1
        assertEquals(9, InkSurfacePatchExtractor.boundaryPlane(Direction.EAST, 8, 0, 0));

        // WEST (NEGATIVE X): plane = x
        assertEquals(8, InkSurfacePatchExtractor.boundaryPlane(Direction.WEST, 8, 0, 0));

        // SOUTH (POSITIVE Z): plane = z + 1
        assertEquals(9, InkSurfacePatchExtractor.boundaryPlane(Direction.SOUTH, 0, 0, 8));

        // NORTH (NEGATIVE Z): plane = z
        assertEquals(8, InkSurfacePatchExtractor.boundaryPlane(Direction.NORTH, 0, 0, 8));
    }

