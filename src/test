    // ========================================================================
    // 値域テスト
    // ========================================================================

    @Test
    @DisplayName("boundaryPlaneは常に0..16の範囲")
    void boundaryPlaneValueRange() {
        for (Direction normal : Direction.values()) {
            for (int y = 0; y < 16; y++) {
                for (int x = 0; x < 16; x++) {
                    for (int z = 0; z < 16; z++) {
                        int plane = InkSurfacePatchExtractor.boundaryPlane(normal, x, y, z);
                        assertTrue(plane >= 0 && plane <= 16,
                                "plane out of range: " + plane + " for " + normal + " at " + x + "," + y + "," + z);
                    }
                }
            }
        }
    }

    @Test
    @DisplayName("toFaceCellUVは常に0..15の範囲")
    void faceCellUVValueRange() {
        for (Direction normal : Direction.values()) {
            for (int y = 0; y < 16; y++) {
                for (int x = 0; x < 16; x++) {
                    for (int z = 0; z < 16; z++) {
                        InkSurfacePatchExtractor.FaceCellUV uv =
                                InkSurfacePatchExtractor.toFaceCellUV(normal, x, y, z);
                        assertTrue(uv.u() >= 0 && uv.u() < 16,
                                "u out of range: " + uv.u() + " for " + normal);
                        assertTrue(uv.v() >= 0 && uv.v() < 16,
                                "v out of range: " + uv.v() + " for " + normal);
                    }
                }
            }
        }
    }

